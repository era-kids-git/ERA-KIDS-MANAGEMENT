{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ERA Kids Management Database Blueprint",
  "description": "Firestore database schema and rules for ERA Kids Volleyball registration, attendance, and media management",
  "entities": {
    "registrations": {
      "title": "Student Registrations",
      "description": "Registrasi dan biodata siswa ERA Kids Volleyball",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "regNumber": { "type": "string" },
        "studentName": { "type": "string" },
        "nickname": { "type": "string" },
        "birthDate": { "type": "string" },
        "gender": { "type": "string" },
        "address": { "type": "string" },
        "parentName": { "type": "string" },
        "parentWhatsapp": { "type": "string" },
        "programName": { "type": "string" },
        "packageDuration": { "type": "string" },
        "trainingSchedule": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["UNPAID", "VERIFIED"] },
        "registrationFee": { "type": "number" },
        "coachingFee": { "type": "number" },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "regNumber", "studentName", "parentWhatsapp", "paymentStatus", "createdAt"]
    },
    "training_sessions": {
      "title": "Training Sessions & Attendance",
      "description": "Sesi presensi dan dokumentasi latihan ERA Kids Volleyball",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "timeRange": { "type": "string" },
        "sessionTitle": { "type": "string" },
        "coachName": { "type": "string" },
        "location": { "type": "string" },
        "programName": { "type": "string" },
        "records": { "type": "array" },
        "documentationMedia": { "type": "array" },
        "mediaCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "date", "sessionTitle", "coachName", "records", "createdAt"]
    },
    "training_media": {
      "title": "Training Documentation Media",
      "description": "Koleksi foto dan video sesi latihan ERA Kids yang terpisah dari presensi",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "type": { "type": "string", "enum": ["photo", "video"] },
        "url": { "type": "string" },
        "name": { "type": "string" },
        "sizeFormatted": { "type": "string" },
        "sizeBytes": { "type": "number" },
        "caption": { "type": "string" },
        "uploadedAt": { "type": "string" }
      },
      "required": ["id", "sessionId", "type", "url", "uploadedAt"]
    },
    "whatsapp_notifications": {
      "title": "WhatsApp Notifications Log",
      "description": "Log notifikasi pengingat WhatsApp",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "recipientName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "status": { "type": "string" },
        "sentAt": { "type": "string" },
        "messageText": { "type": "string" }
      },
      "required": ["id", "recipientName", "phoneNumber", "status", "sentAt"]
    }
  },
  "firestoreRules": {
    "description": "Public read/write rules for app operational access",
    "rules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /registrations/{document=**} {\n      allow read, write: if true;\n    }\n    match /training_sessions/{document=**} {\n      allow read, write: if true;\n    }\n    match /training_media/{document=**} {\n      allow read, write: if true;\n    }\n    match /whatsapp_notifications/{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
  }
}
